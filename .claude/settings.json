{
  "permissions": {
    "allow": [
      "Bash(JORAH_ALLOW_MAIN=1 git push origin HEAD:main)",
      "Bash(JORAH_ALLOW_MAIN=1 git -C * push origin HEAD:main)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  }
}
