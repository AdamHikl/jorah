// Jorah's GitHub push path (plugins/jorah-github) through the jorah-bot GitHub App (ID 5686503),
// on Adam's decision of 2026-11-09 to bring it forward from M3. Each push and pull request waits
// for Adam's approval; rulesets on each repo (scripts/github/protect-repo.sh) limit the App to
// jorah/** server-side. Add a repo: protect-repo.sh, tick it in the App's installation, add it here.
// Merge patch: plugins.allow is the whole list as of 2026-11-09 plus the plugin.
{
  plugins: {
    allow: [
      "anthropic",
      "telegram",
      "acpx",
      "memory-core",
      "active-memory",
      "memory-wiki",
      "device-pair",
      "talk-voice",
      "browser",
      "duckduckgo",
      "jorah-voice-provider",
      "jorah-github",
    ],
    entries: {
      "jorah-github": {
        config: {
          appId: "5686503",
          keyFile: "/home/jorah/.config/jorah-github/app.pem",
          // Folder name under /home/jorah/work -> owner/repo. Only these can be pushed to.
          repos: {
            threadfolio: "AdamHikl/threadfolio",
          },
        },
      },
    },
  },
}
