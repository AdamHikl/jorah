// Jorah's GitHub push path (plugins/jorah-github), on Adam's decision of 2026-11-09 to bring the
// jorah account forward from M3. Fill ACCOUNT and the repos before applying.
// Each push and pull request waits for Adam's approval; rulesets on each repo
// (scripts/github/protect-repo.sh) limit the account to jorah/** server-side.
// Merge patch: plugins.allow is the whole list as of 2026-11-09 plus the plugin.
{
  plugins: {
    allow: [
      "anthropic",
      "telegram",
      "acpx",
      "memory-core",
      "active-memory",
      "memory-wiki",
      "device-pair",
      "talk-voice",
      "browser",
      "duckduckgo",
      "jorah-voice-provider",
      "jorah-github",
    ],
    entries: {
      "jorah-github": {
        config: {
          account: "ACCOUNT",
          // Folder name under /home/jorah/work -> owner/repo. Only these can be pushed to.
          repos: {
            // "example-project": "AdamHikl/example-project",
          },
        },
      },
    },
  },
}
