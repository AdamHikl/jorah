// Jorah's GitHub path (plugins/jorah-github) through the jorah-bot GitHub App (ID 5686503),
// on Adam's decision of 2026-11-09 to bring it forward from M3, widened to all his repos on
// 2026-11-10. Any repo of `owner` can be cloned and synced (read-only). Each push and pull request
// waits for Adam's approval, and the plugin first checks live that the repo's rulesets
// (scripts/github/protect-repo.sh) limit the App to jorah/**; a repo without them is sync-only.
// Merge patch: plugins.allow is the whole list as of 2026-11-09 plus the plugin. `repos: null`
// deletes the old fixed list (threadfolio), which `owner` now covers.
{
  plugins: {
    allow: [
      "anthropic",
      "telegram",
      "acpx",
      "memory-core",
      "active-memory",
      "memory-wiki",
      "device-pair",
      "talk-voice",
      "browser",
      "duckduckgo",
      "jorah-voice-provider",
      "jorah-github",
    ],
    entries: {
      "jorah-github": {
        config: {
          appId: "5686503",
          keyFile: "/home/jorah/.config/jorah-github/app.pem",
          // Folder name under /home/jorah/work = repo name under this account.
          owner: "AdamHikl",
          // Only for a folder named differently from its repo: { folder: "AdamHikl/repo" }.
          repos: null,
        },
      },
    },
  },
}
