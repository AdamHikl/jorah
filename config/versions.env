# What runs live on the PC (jorah WSL, profile jorah). Update with every upgrade, together with the
# runbook (docs/runbooks/jorah-on-pc.md). Read by scripts/configure.sh.
#
# OpenClaw 2026.11.6 since 2026-11-22 18:04 CET (was 2026.10.9). Installed with a written exception
# to the 7-day rule (Adam, 2026-11-22), see the runbook section "Target 2026.11.6 instead of 10.33".
OPENCLAW_VERSION=2026.11.6
# Official plugins, updated by `openclaw doctor --fix` with OpenClaw.
OPENCLAW_ACPX_VERSION=2026.11.6
OPENCLAW_DUCKDUCKGO_VERSION=2026.11.6
# Jorah's own Claude Code (~/.local/bin/claude, CLAUDE_CONFIG_DIR=~/.claude-jorah), also the pinned
# copy the ACP adapter starts (/opt/jorah-tools/claude-code/2.1.300).
CLAUDE_CODE_VERSION=2.1.300
# The ACP adapter, root-owned in /opt/jorah-tools (scripts/pc/install-claude-acp.sh).
CLAUDE_AGENT_ACP_VERSION=0.76.0
NODE_VERSION=26.13.0
# Gateway port, loopback only.
GATEWAY_PORT=43181
