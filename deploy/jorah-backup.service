# Daily backup of Jorah's state and workspaces on the PC, local only.
# Offsite (README decision 41: restic to Hetzner, passphrase offline) is still Adam's choice.
# The archive holds the secrets store and credentials, so it stays in jorah's mode-700 home.
[Unit]
Description=Jorah: daily OpenClaw backup, local, verified
After=openclaw-gateway.service

[Service]
Type=oneshot
User=jorah
Group=jorah
UMask=0077
WorkingDirectory=/home/jorah
Environment=HOME=/home/jorah
Environment=PATH=/home/jorah/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p /home/jorah/backups
# OpenClaw's --keep-* retention needs a storage location (--to), which comes with the offsite decision.
# Until then: a local archive, verified, and archives older than 14 days removed.
ExecStart=/usr/local/bin/openclaw --profile jorah backup create --output /home/jorah/backups --verify
# agentmemory's data (memories, indexes, its secret) since 2026-11-08: a dated tar next to the archive.
ExecStartPost=/bin/sh -c 'tar -C /home/jorah/.local/share -czf "/home/jorah/backups/$(date +%%Y-%%m-%%dT%%H-%%M)-agentmemory-backup.tar.gz" agentmemory'
ExecStartPost=/bin/sh -c 'find /home/jorah/backups -maxdepth 1 -type f \\( -name "*openclaw-backup*" -o -name "*agentmemory-backup*" \\) -mtime +14 -delete'
Nice=10
IOSchedulingClass=idle
InaccessiblePaths=/run/WSL
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
