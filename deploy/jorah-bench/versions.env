# Robotics bench pins (docs/plan/11-project-mode.md section 7, docs/runbooks/robotics-bench.md).
# Read by scripts/pc/install-robotics-bench.sh and copied to /opt/jorah-bench/versions.env.
# Every pin is at least 7 days old on 2026-11-16 (Adam's 7-day rule), except Ubuntu's own
# archive packages: see "Exceptions" in the runbook.
# Plain KEY=value lines only: no expansion, no commands.

# ROS 2 Jazzy from the ROS snapshot repository: a frozen copy of packages.ros.org taken after the
# sync of 2026-10-05, published 2026-10-12 (InRelease Date). Moving to a newer snapshot is a
# change of this line and a rerun of the install.
ROS_DISTRO=jazzy
ROS_SNAPSHOT=2026-10-05
ROS_SNAPSHOT_URL=http://snapshots.ros.org/jazzy/2026-10-05/ubuntu
# rosdep keys and the rosdistro index at the matching tag of ros/rosdistro (the snapshot's own advice).
ROSDISTRO_TAG=jazzy/2026-10-05

# Signing key of snapshots.ros.org, "ROS Snapshot builder <rosbuild@ros.org>", created 2018-11-19.
# Official page: http://wiki.ros.org/SnapshotRepository (fingerprint given there for the keyserver).
# Checked 2026-11-16: the 2026-10-05 InRelease is signed by this key; its latest self-signature
# (2025-08-27) sets expiry to 2027-05-31.
ROS_SNAPSHOT_KEY_FPR=4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA

# The live ROS repository's key and the OSRF (Gazebo) key are recorded in
# docs/runbooks/robotics-bench.md ("Signing keys"); this install trusts neither.

# PlatformIO Core (PyPI, released 2026-09-05) and platforms (PlatformIO registry).
PIO_VERSION=6.2.0
PIO_ESPRESSIF32=8.0.0
PIO_RASPBERRYPI=1.20.0

# build123d (PyPI, released 2026-09-21). Its whole tree is pinned with hashes in requirements-cad.txt.
BUILD123D_VERSION=0.13.0
