#!/usr/sbin/nft -f
# Limits what the jorah user can reach. jorah has no root, so it can't change this.
# Public internet on web ports is allowed. The LAN, the tailnet and Windows are not.
flush ruleset

table inet jorah_out {
  set private4 {
    type ipv4_addr; flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 169.254.0.0/16, 172.16.0.0/12,
                 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
  }
  set private6 {
    type ipv6_addr; flags interval
    elements = { fc00::/7, fe80::/10, ff00::/8 }
  }

  # Linux's own ephemeral range, which WSL sets under mirrored networking and which moves between
  # boots (43255-47350 on 2026-11-06, 55540-59635 after the reboot of 2026-11-10). Claude Code's
  # sandbox proxy and OpenClaw's tool bridge listen on random ports in it. This element is only
  # the boot-time default: jorah-firewall-ports.service replaces it with the live range from
  # net.ipv4.ip_local_port_range after every load of this file.
  set ephemeral {
    type inet_service; flags interval
    elements = { 43255-47350 }
  }

  chain output {
    type filter hook output priority filter; policy accept;
    # Site readers (docs/runbooks/site-readers.md, 2026-11-15) and the toolbox installer. Fixed ids,
    # so this file loads even before the install scripts create the users.
    # 1101 jorah-sites, the signed-in site browsers: the site proxy on 43219 (43218 is the test
    # proxy for jorah-dev's fake site) and nothing else.
    # Established covers Chrome's replies to the Gateway on its DevTools port, which jorah opened.
    meta skuid 1101 ct state established,related accept
    meta skuid 1101 oifname { "lo", "loopback0" } tcp dport { 43218, 43219 } accept
    meta skuid 1101 counter reject
    # 1102 jorah-proxy, the site proxy: DNS and public HTTPS; never the LAN, the tailnet or loopback,
    # except 43228, the fake site that only runs during jorah-dev tests.
    meta skuid 1102 ct state established,related accept
    meta skuid 1102 ip daddr 10.255.255.254 meta l4proto { tcp, udp } th dport 53 accept
    meta skuid 1102 oifname { "lo", "loopback0" } tcp dport 43228 accept
    meta skuid 1102 oifname { "lo", "loopback0" } counter reject
    meta skuid 1102 ip daddr @private4 counter reject
    meta skuid 1102 ip6 daddr @private6 counter reject
    meta skuid 1102 tcp dport 443 accept
    meta skuid 1102 counter reject
    # 1103 jorah-toolbox, the toolbox installer (docs/runbooks/toolbox.md, 2026-11-17): DNS and public
    # HTTPS, to fetch a tool Adam approved and GitHub's record of its release; never the LAN, the
    # tailnet or loopback.
    meta skuid 1103 ct state established,related accept
    meta skuid 1103 ip daddr 10.255.255.254 meta l4proto { tcp, udp } th dport 53 accept
    meta skuid 1103 oifname { "lo", "loopback0" } counter reject
    meta skuid 1103 ip daddr @private4 counter reject
    meta skuid 1103 ip6 daddr @private6 counter reject
    meta skuid 1103 tcp dport 443 accept
    meta skuid 1103 counter reject
    meta skuid != 1000 accept
    ct state established,related accept
    # Mirrored networking sends all loopback TCP through this interface, whether it ends up
    # in this distro or on Windows, so only jorah's own ports are allowed.
    # 43181-43199 is the Gateway and its derived ports, 43210 is speech, 43212 jorah-phone (the
    # phone_today tool reads /today there), 47300-47304 agentmemory,
    # 43220-43229 the site browsers' DevTools ports, which the Gateway drives for the site reader.
    oifname "loopback0" tcp dport { 43181-43199, 43210, 43212, 43220-43229, 47300-47304 } accept
    oifname "loopback0" tcp dport @ephemeral accept
    oifname "loopback0" counter reject
    # WSL's DNS stub, which sits inside 10.0.0.0/8.
    ip daddr 10.255.255.254 meta l4proto { tcp, udp } th dport 53 accept
    ip daddr @private4 counter reject
    ip6 daddr @private6 counter reject
    # Public internet: web ports only (2026-11-08). Jorah's web, browser, Anthropic, Telegram,
    # npm and Hugging Face all use 443; 80 for plain-http pages; udp 443 for HTTP/3. Mail, SSH,
    # IRC and other ports a page could talk him into are refused. Only 443 was in use when
    # measured. A domain list isn't possible here: web search and the browser need any site.
    meta l4proto tcp th dport { 80, 443 } accept
    udp dport 443 accept
    counter reject
  }
}
