#!/usr/sbin/nft -f
# Limits what the jorah user can reach. jorah has no root, so it can't change this.
# Public internet on web ports is allowed. The LAN, the tailnet and Windows are not.
flush ruleset

table inet jorah_out {
  set private4 {
    type ipv4_addr; flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 169.254.0.0/16, 172.16.0.0/12,
                 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
  }
  set private6 {
    type ipv6_addr; flags interval
    elements = { fc00::/7, fe80::/10, ff00::/8 }
  }

  # Linux's own ephemeral range, which WSL sets under mirrored networking and which moves between
  # boots (43255-47350 on 2026-11-06, 55540-59635 after the reboot of 2026-11-10). Claude Code's
  # sandbox proxy and OpenClaw's tool bridge listen on random ports in it. This element is only
  # the boot-time default: jorah-firewall-ports.service replaces it with the live range from
  # net.ipv4.ip_local_port_range after every load of this file.
  set ephemeral {
    type inet_service; flags interval
    elements = { 43255-47350 }
  }

  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid != 1000 accept
    ct state established,related accept
    # Mirrored networking sends all loopback TCP through this interface, whether it ends up
    # in this distro or on Windows, so only jorah's own ports are allowed.
    # 43181-43199 is the Gateway and its derived ports, 43210 is speech, 47300-47304 agentmemory.
    oifname "loopback0" tcp dport { 43181-43199, 43210, 47300-47304 } accept
    oifname "loopback0" tcp dport @ephemeral accept
    oifname "loopback0" counter reject
    # WSL's DNS stub, which sits inside 10.0.0.0/8.
    ip daddr 10.255.255.254 meta l4proto { tcp, udp } th dport 53 accept
    ip daddr @private4 counter reject
    ip6 daddr @private6 counter reject
    # Public internet: web ports only (2026-11-08). Jorah's web, browser, Anthropic, Telegram,
    # npm and Hugging Face all use 443; 80 for plain-http pages; udp 443 for HTTP/3. Mail, SSH,
    # IRC and other ports a page could talk him into are refused. Only 443 was in use when
    # measured. A domain list isn't possible here: web search and the browser need any site.
    meta l4proto tcp th dport { 80, 443 } accept
    udp dport 443 accept
    counter reject
  }
}
