[Unit]
Description=Jorah voice: speech to and from Jorah's main session, reached only through Tailscale Serve
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
User=jorah
WorkingDirectory=/opt/jorah/services/jorah-voice
ExecStart=/home/jorah/.venv/bin/python -m jorah_voice.server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# The code is read-only to it, and the rest of the system is out of reach.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/jorah/.cache/jorah-voice
BindReadOnlyPaths=/home/jorah/.venv /home/jorah/.local /home/jorah/.config/jorah-voice
PrivateTmp=yes
# The GPU is /dev/dxg in WSL, so devices stay visible, but only that one is allowed.
DeviceAllow=/dev/dxg rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=10G

[Install]
WantedBy=multi-user.target
