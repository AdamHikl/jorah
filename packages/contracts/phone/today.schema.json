{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jorah-phone/today/v1",
  "title": "Today's phone picture, written by code (GET /today, local callers only; the phone_today tool)",
  "description": "Every value comes from stored events and day rows, computed by code. Missing data is null with a status, never zero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "generated_at", "tz", "date", "phone", "health"],
  "properties": {
    "v": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "tz": { "type": "string", "maxLength": 64 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_event", "location", "woke_at", "focus"],
      "properties": {
        "status": { "enum": ["ok", "no_data"], "description": "no_data: no event stored in the last 30 days" },
        "last_event": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "place", "focus", "at"],
          "properties": {
            "kind": { "enum": ["arrive", "leave", "alarm_stopped", "wake", "focus_on", "focus_off"] },
            "place": { "enum": ["home", "school", "other", null] },
            "focus": { "enum": ["sleep", "work", "personal", "school", "driving", "fitness", "reading", "do_not_disturb", "other", null] },
            "at": { "type": "string", "format": "date-time" }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "place", "since"],
          "description": "From the latest arrive or leave event in the last 24 hours. unknown when there is none",
          "properties": {
            "state": { "enum": ["at", "left", "unknown"] },
            "place": { "enum": ["home", "school", "other", null] },
            "since": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "woke_at": { "type": ["string", "null"], "format": "date-time", "description": "Today's first alarm_stopped or wake event" },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "since"],
          "description": "The latest focus_on in the last 24 hours with no later focus_off for the same focus",
          "properties": {
            "value": { "enum": ["sleep", "work", "personal", "school", "driving", "fitness", "reading", "do_not_disturb", "other", null] },
            "since": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "received_at", "night", "hrv_ms", "resting_bpm", "workouts"],
      "properties": {
        "status": {
          "enum": ["off", "ok", "no_data", "stale"],
          "description": "off: health upload is turned off (service or plugin). no_data: nothing stored. stale: the newest row is not today's; its date is in night.date"
        },
        "received_at": { "type": ["string", "null"], "format": "date-time" },
        "night": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["date", "bed", "wake", "asleep_min", "median_14d_min"],
          "properties": {
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The day the night ended" },
            "bed": { "type": "string", "format": "date-time" },
            "wake": { "type": "string", "format": "date-time" },
            "asleep_min": { "type": "integer", "minimum": 0, "maximum": 1440 },
            "median_14d_min": { "type": ["integer", "null"], "minimum": 0, "maximum": 1440, "description": "Median of the 14 days before, null with fewer than 3 nights" }
          }
        },
        "hrv_ms": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["value", "median_14d"],
          "properties": {
            "value": { "type": "integer", "minimum": 1, "maximum": 400 },
            "median_14d": { "type": ["integer", "null"], "minimum": 1, "maximum": 400 }
          }
        },
        "resting_bpm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["value", "median_14d"],
          "properties": {
            "value": { "type": "integer", "minimum": 20, "maximum": 250 },
            "median_14d": { "type": ["integer", "null"], "minimum": 20, "maximum": 250 }
          }
        },
        "workouts": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "minutes"],
            "properties": {
              "type": { "enum": ["walking", "running", "cycling", "strength", "swimming", "hiking", "yoga", "hiit", "other"] },
              "minutes": { "type": "integer", "minimum": 0, "maximum": 1440 }
            }
          }
        }
      }
    }
  }
}
