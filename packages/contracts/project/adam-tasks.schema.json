{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jorah-project/adam-tasks/v1",
  "title": "project/adam-tasks.yaml: physical and money tasks for Adam. Jorah writes them; only the runner writes result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "tasks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "why", "when", "steps", "send_back", "status", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^A-[0-9]{4}$", "description": "A- and 4 digits, never reused" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "why": { "type": "string", "minLength": 1, "maxLength": 600 },
          "when": { "type": "string", "minLength": 1, "maxLength": 200, "description": "When and how long, in words: 'Any day, 10 minutes'" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": { "type": "string", "minLength": 1, "maxLength": 400 }
          },
          "materials": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 },
            "description": "Empty when left out"
          },
          "send_back": { "type": "string", "minLength": 1, "maxLength": 400 },
          "status": { "enum": ["open", "done", "skipped"] },
          "result": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["text", "files", "at"],
            "description": "Written only by the runner, from what Adam sent back through the inbox",
            "properties": {
              "text": { "type": ["string", "null"], "maxLength": 4000 },
              "files": {
                "type": "array",
                "maxItems": 50,
                "items": { "type": "string", "pattern": "^field-data/A-[0-9]{4}-[A-Za-z0-9_-]{1,40}\\.[A-Za-z0-9]{1,8}$" }
              },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
