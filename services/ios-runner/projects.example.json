{
  "contract": "jorah-ios/1",
  "installAllowed": false,
  "simulatorAllowed": false,
  "team": "ABCDE12345",
  "stateDir": "~/Library/Application Support/jorah-ios-runner",
  "handoffDir": "/Users/Shared/jorah-handoff",
  "keyFile": "~/.config/jorah-ios/runner.key",
  "listen": { "host": "127.0.0.1", "port": 47820 },
  "path": ["/usr/bin", "/bin", "/usr/sbin", "/sbin", "/opt/homebrew/bin"],
  "developerDir": null,
  "maxLogBytes": 67108864,
  "keepRuns": 200,
  "timeouts": {
    "git": 300,
    "prepare": 1800,
    "build": 2700,
    "install": 300,
    "launch": 120,
    "devices": 60,
    "codesign": 60,
    "simulator": 300
  },
  "projects": {
    "example-app": {
      "repo": "example-owner/example-app",
      "path": "/Users/jorah-build/src/example-app",
      "workspace": "ios/ExampleApp.xcworkspace",
      "scheme": "ExampleApp",
      "bundleId": "com.example.placeholder",
      "prepare": ["pnpm-install", { "step": "expo-prebuild", "dir": "." }, "pod-install"],
      "restore": ["package.json"],
      "env": { "EXAMPLE_APP_VARIANT": "dev" },
      "signing": {
        "style": "manual",
        "profiles": { "ExampleApp": "Jorah com.example.placeholder" },
        "allowProvisioningUpdates": false
      }
    }
  },
  "devices": {
    "example-iphone": { "udid": "00000000-0000000000000000" }
  }
}
