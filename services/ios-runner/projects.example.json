      "scheme": "ExampleApp",
      "configuration": "Debug",
      "bundle_id": "com.example.placeholder",
      "team_id": "ABCDE12345",
      "prepare": ["pnpm-install", "pod-install"]
    }
  },
  "devices": {
    "example-iphone": { "udid": "00000000-0000000000000000" }
  }
