#!/usr/bin/env python3
"""Make, list and revoke jorah-phone's tokens. Run as jorah, in a Terminal attached to no agent.

  jorah-phone-token new iphone --scopes ask,ingest      prints the token once; type or paste it into the Shortcuts
  jorah-phone-token new gateway --scopes read --to-file ~/.config/jorah-phone/read-token
                                                        writes it to a mode-600 file and prints nothing secret
  jorah-phone-token list                                ids, scopes and dates, never tokens
  jorah-phone-token revoke iphone                       takes effect at once, no restart
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from jorah_phone.tokens import DEFAULT_FILE, SCOPES, TokenError, listing, new_token, revoke, write_token_file  # noqa: E402


def main(argv=None):
    p = argparse.ArgumentParser(prog="jorah-phone-token", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--tokens", default=str(DEFAULT_FILE))
    sub = p.add_subparsers(dest="command", required=True)
    n = sub.add_parser("new")
    n.add_argument("id")
    n.add_argument("--scopes", required=True, help=f"comma-separated: {', '.join(SCOPES)}")
    n.add_argument("--to-file", help="write the token to this file (mode 600) instead of printing it")
    n.add_argument("--replace", action="store_true", help="replace an existing token with this id")
    sub.add_parser("list")
    r = sub.add_parser("revoke")
    r.add_argument("id")
    args = p.parse_args(argv)
    try:
        if args.command == "new":
            token = new_token(args.tokens, args.id, [s.strip() for s in args.scopes.split(",") if s.strip()], replace=args.replace)
            if args.to_file:
                write_token_file(Path(args.to_file).expanduser(), token)
                print(f"Token {args.id} made and written to {args.to_file} (mode 600).")
            else:
                print(f"Token {args.id}, shown once. Put it in the Shortcut's Authorization header as: Bearer <token>")
                print(token)
        elif args.command == "list":
            for entry in listing(args.tokens):
                print(f"{entry['id']}\t{','.join(entry['scopes'])}\t{entry.get('created') or '?'}")
        else:
            print(f"Revoked {args.id}." if revoke(args.tokens, args.id) else f"No token named {args.id}.")
    except TokenError as error:
        print(f"jorah-phone-token: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
